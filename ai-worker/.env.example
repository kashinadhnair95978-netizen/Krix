# =====================================================================
# Krix AI worker — environment variables
# Copy to ai-worker/.env and fill in. NEVER commit .env with real values.
# The Next.js app reads AI_WORKER_URL + AI_WORKER_API_KEY (see root .env.example).
# =====================================================================

# --- Server ---
AI_WORKER_HOST=127.0.0.1
AI_WORKER_PORT=8741
# Shared secret the Next.js API route sends as `Authorization: Bearer <key>`.
# Generate one with: openssl rand -hex 32
AI_WORKER_API_KEY=changeme
# Set to "false" ONLY for local development without auth.
AI_WORKER_AUTH=true

# --- Supabase (service role — server-side only, never in the browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_VIDEOS_BUCKET=videos
SUPABASE_CLIPS_BUCKET=generated_clips

# --- Model cache / tokens ---
HF_HOME=C:/Users/you/.cache/huggingface
# Only needed for gated models. The Krix models are public — leave empty.
HF_TOKEN=

# --- Models (switch models here, no code changes) ---
ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf
ASR_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B-hf
ASR_DEVICE=cuda
ASR_LANGUAGE=
ASR_MAX_NEW_TOKENS=512
ASR_ENABLE_TIMESTAMPS=true
ASR_ALIGN_CHUNK_SECONDS=240

VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct
VISION_DEVICE=cuda
# 8bit (bitsandbytes, fits 8GB) | fp16 (only if memory allows)
VISION_QUANTIZATION=8bit
VISION_MAX_NEW_TOKENS=256

MISTRAL_MODEL=mistralai/Mistral-7B-Instruct-v0.3
MISTRAL_DEVICE=cuda
# 4bit (NF4 BitsAndBytes — fits 8GB) | 8bit | fp16
MISTRAL_QUANTIZATION=4bit
MISTRAL_MAX_NEW_TOKENS=900
MISTRAL_TEMPERATURE=0.1

# --- FFmpeg (full build with libass for captions) ---
# Leave empty if ffmpeg/ffprobe are on PATH, otherwise point at the binaries.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Rendering ---
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_CRF=23
RENDER_AUDIO_BITRATE=128k

# --- Pipeline tuning ---
MAX_CLIPS=3
MIN_CLIP_DURATION=20
MAX_CLIP_DURATION=90
FRAME_SAMPLE_INTERVAL=10
MAX_VISION_FRAMES=12
VISION_START_OFFSET=0

# --- Captions (one excellent default style) ---
CAPTION_FONT_SIZE=72
CAPTION_FONT_COLOR=FFFFFF
CAPTION_OUTLINE_COLOR=000000
CAPTION_OUTLINE_WIDTH=3
CAPTION_MARGIN_BOTTOM=120
CAPTION_MAX_CHARS=32
CAPTION_STYLE_NAME=Krix

# --- Misc ---
AI_WORKER_WORK_DIR=ai-worker/work
AI_WORKER_KEEP_ARTIFACTS=false
SUPABASE_TIMEOUT=120
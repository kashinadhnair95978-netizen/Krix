# =====================================================================
# Krix AI worker — environment variables
# Copy to ai-worker/.env and fill in. NEVER commit .env with real values.
# The Next.js app reads AI_WORKER_URL + AI_WORKER_API_KEY (see root .env.example).
# =====================================================================

# --- Server ---
AI_WORKER_HOST=127.0.0.1
AI_WORKER_PORT=8741
# Shared secret the Next.js API route sends as `Authorization: Bearer <key>`.
# Generate one with: openssl rand -hex 32
AI_WORKER_API_KEY=changeme
# Set to "false" ONLY for local development without auth.
AI_WORKER_AUTH=true

# --- Supabase (service role — server-side only, never in the browser) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_VIDEOS_BUCKET=videos
SUPABASE_CLIPS_BUCKET=generated_clips

# --- Model cache / tokens ---
HF_HOME=C:/Users/you/.cache/huggingface
# Only needed for gated models. The Krix models are public — leave empty.
HF_TOKEN=

# --- Models (switch models here, no code changes) ---
ASR_MODEL=Qwen/Qwen3-ASR-1.7B-hf
ASR_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B-hf
ASR_DEVICE=cuda
ASR_LANGUAGE=
# Hard ceiling for one generation call. Long audio is split by ASR_CHUNK_SECONDS
# and each chunk gets its own budget, so this is a per-chunk cap, not the fix for
# truncation.
ASR_MAX_NEW_TOKENS=4096
ASR_ENABLE_TIMESTAMPS=true
# Long-video chunking. 300s windows with 2s overlap; word timestamps are offset
# per chunk and the overlap text is de-duplicated when stitching.
ASR_CHUNK_SECONDS=300
ASR_CHUNK_OVERLAP_SECONDS=2
# Used to scale each chunk's generation budget from its duration.
ASR_TOKENS_PER_SECOND=8
# The aligner's own per-pass audio limit.
ASR_ALIGN_CHUNK_SECONDS=240

VISION_MODEL=Qwen/Qwen3-VL-4B-Instruct
VISION_DEVICE=cuda
# 8bit (bitsandbytes, fits 8GB) | fp16 (only if memory allows)
VISION_QUANTIZATION=8bit
VISION_MAX_NEW_TOKENS=256

MISTRAL_MODEL=mistralai/Mistral-7B-Instruct-v0.3
MISTRAL_DEVICE=cuda
# 4bit (NF4 BitsAndBytes — fits 8GB) | 8bit | fp16
MISTRAL_QUANTIZATION=4bit
MISTRAL_MAX_NEW_TOKENS=900
MISTRAL_TEMPERATURE=0.1
# Hard cap on the prompt (tokenized and truncated, never silently dropped).
MISTRAL_MAX_INPUT_TOKENS=16384

# --- Single-GPU job queue ---
# One job at a time holds the GPU. Total backlog = running + waiting; anything
# above this returns a structured BUSY (HTTP 429) instead of queueing forever.
GPU_QUEUE_MAX_PENDING=16
GPU_QUEUE_STATUS_LIMIT=25
# How long a debug endpoint (/transcribe, /analyze-video, ...) waits for a free
# GPU lease before returning BUSY.
GPU_LEASE_TIMEOUT=3600

# --- Automatic repurposing (server-to-server, after a video completes) ---
# When true, a finished video triggers POST {APP_BASE_URL}/api/repurpose with
# the x-service-key header. Failures are non-fatal and never fail the pipeline.
REPURPOSE_ON_COMPLETE=true
REPURPOSE_TIMEOUT=300
# Base URL of the Next.js app. KRIX_APP_URL is the canonical name; both are read.
KRIX_APP_URL=http://127.0.0.1:3000
APP_BASE_URL=http://127.0.0.1:3000
# MUST match INTERNAL_SERVICE_KEY in the root .env(.local). Without it the
# callback is disabled and the worker logs why.
INTERNAL_SERVICE_KEY=changeme

# --- FFmpeg (full build with libass for captions) ---
# Leave empty if ffmpeg/ffprobe are on PATH, otherwise point at the binaries.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Rendering ---
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_CRF=23
RENDER_AUDIO_BITRATE=128k

# --- Pipeline tuning ---
MAX_CLIPS=3
MIN_CLIP_DURATION=20
MAX_CLIP_DURATION=90
FRAME_SAMPLE_INTERVAL=10
MAX_VISION_FRAMES=12
VISION_START_OFFSET=0

# --- Captions (one excellent default style) ---
CAPTION_FONT_SIZE=72
CAPTION_FONT_COLOR=FFFFFF
CAPTION_OUTLINE_COLOR=000000
CAPTION_OUTLINE_WIDTH=3
CAPTION_MARGIN_BOTTOM=120
CAPTION_MAX_CHARS=32
CAPTION_STYLE_NAME=Krix

# --- Misc ---
AI_WORKER_WORK_DIR=ai-worker/work
AI_WORKER_KEEP_ARTIFACTS=false
SUPABASE_TIMEOUT=120
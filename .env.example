# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://kdxtfypsogmlqobnamuf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[your-anon-key]
SUPABASE_SERVICE_ROLE_KEY=[your-service-role-key]

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# AI — works with ANY provider. AI_PROVIDER picks one explicitly,
# or set it to "auto" to use the first key that is present.
AI_PROVIDER=auto

# Provide at least ONE API key below:

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-opus-4-1

# OpenAI (GPT / Whisper)
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (any model, OpenAI-compatible).
# OPENROUTER_MODEL must be a model OpenRouter currently serves — retired ids
# (e.g. anthropic/claude-3.5-sonnet) are rejected up front with a
# configuration error instead of failing as a provider 500.
OPENROUTER_API_KEY=sk-or-xxxxx
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Custom OpenAI-compatible endpoint (Groq, Together, Ollama, LM Studio...)
AI_API_KEY=xxxxx
AI_BASE_URL=https://api.groq.com/openai/v1

# Optional shared model override for the active provider
# AI_MODEL=

# Geo-IP (MaxMind)
MAXMIND_ACCOUNT_ID=xxxxx
MAXMIND_LICENSE_KEY=xxxxx

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL the server uses for its own server-to-server calls
# (upload / ingest-url → /api/pipeline/process). Defaults to NEXT_PUBLIC_APP_URL.
KRIX_APP_URL=http://localhost:3000

# Internal server-to-server calls (upload → process-video → repurpose).
# Generate one with: openssl rand -hex 32
INTERNAL_SERVICE_KEY=changeme

# AI worker (Python/FastAPI video pipeline: ASR → visual analysis → clips).
# When set, uploads trigger the worker pipeline instead of the in-app flow.
# Must match AI_WORKER_AUTH_ENABLED / AI_WORKER_API_KEY in ai-worker/.env.
AI_WORKER_URL=http://127.0.0.1:8741
AI_WORKER_API_KEY=changeme

# ---------------------------------------------------------------------------
# Video ingestion limits
# ---------------------------------------------------------------------------
# The app-level upload cap. Note that the real ceiling is min(of this, the
# Supabase project's per-object Storage limit) — a Supabase bucket left at
# file_size_limit = null inherits the plan default (50 MB on the free tier),
# which is what the server reports through GET /api/upload.
UPLOAD_MAX_BYTES=2147483648

# Override the assumed Supabase per-object ceiling when the bucket is pinned.
STORAGE_MAX_BYTES=52428800

# Remote link import (YouTube) ceilings.
#   pip install yt-dlp   (or set YTDLP_PATH to the executable)
#   FFPROBE_PATH         optional; auto-detected on PATH
YTDLP_PATH=
FFPROBE_PATH=
INGEST_MAX_BYTES=52428800
INGEST_MAX_DURATION_SECONDS=5400
INGEST_TIMEOUT_SECONDS=900

# Wall-clock budget for ONE /api/ingest-url request (download ladder + storage
# write + pipeline trigger). It is always clamped below the route's maxDuration
# so the endpoint answers with a structured DOWNLOAD_TIMEOUT (504) instead of
# being killed and surfacing as a bare 502.
INGEST_REQUEST_BUDGET_SECONDS=240

# Duplicate-import policy. A link is imported once per user:
#   - an import that is still running is returned (no second download),
#   - a completed import is returned (no re-download),
#   - a failed import is returned for the cooldown below, then retried,
#   - a job stuck longer than INGEST_STALE_SECONDS is treated as dead and may be
#     retried. Send {"force": true} to skip every check and import again.
INGEST_RETRY_COOLDOWN_SECONDS=600
INGEST_STALE_SECONDS=1800
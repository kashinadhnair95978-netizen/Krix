# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://kdxtfypsogmlqobnamuf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=[your-anon-key]
SUPABASE_SERVICE_ROLE_KEY=[your-service-role-key]

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxxxx
STRIPE_SECRET_KEY=sk_live_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Razorpay
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxx
RAZORPAY_KEY_SECRET=xxxxx

# AI — works with ANY provider. AI_PROVIDER picks one explicitly,
# or set it to "auto" to use the first key that is present.
AI_PROVIDER=auto

# Provide at least ONE API key below:

# Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-opus-4-1

# OpenAI (GPT / Whisper)
OPENAI_API_KEY=sk-xxxxx
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (any model, OpenAI-compatible)
OPENROUTER_API_KEY=sk-or-xxxxx
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Custom OpenAI-compatible endpoint (Groq, Together, Ollama, LM Studio...)
AI_API_KEY=xxxxx
AI_BASE_URL=https://api.groq.com/openai/v1

# Optional shared model override for the active provider
# AI_MODEL=

# Geo-IP (MaxMind)
MAXMIND_ACCOUNT_ID=xxxxx
MAXMIND_LICENSE_KEY=xxxxx

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal server-to-server calls (upload → process-video → repurpose).
# Generate one with: openssl rand -hex 32
INTERNAL_SERVICE_KEY=changeme